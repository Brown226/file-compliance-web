generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        String       @id @default(uuid())
  name      String
  parentId  String?
  parent    Department?  @relation("DepartmentToDepartment", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentToDepartment")
  users     User[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("departments")
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  name         String
  email        String?
  role         Role        @default(USER)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  tasks        Task[]
  auditLogs    AuditLog[]
  feedbacks    Feedback[]
  resolvedFeedbacks Feedback[] @relation("FeedbackResolver")
  mustChangePassword Boolean  @default(false) @map("must_change_password")  // 首次登录是否强制改密
  createdAnnouncements SystemAnnouncement[]
  qaSessions   QASession[]
  chatSessions UserChatSession[]
  announcementReads    UserAnnouncementRead[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum StandardStatus {
  CURRENT       // 现行
  UPCOMING      // 即将实施
  ABOLISHED     // 已废止
}

model StandardFolder {
  id        String           @id @default(uuid())
  name      String
  parentId  String?
  parent    StandardFolder?  @relation("FolderToFolder", fields: [parentId], references: [id])
  children  StandardFolder[] @relation("FolderToFolder")
  standards Standard[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("standard_folders")
}

model Standard {
  id                String           @id @default(uuid())
  title             String
  version           String
  isActive          Boolean          @default(true)
  standardNo        String?          // 标准编号，如 "GB/T 50001-2017"
  standardName      String?          // 标准名称，如 "房屋建筑制图统一标准"
  standardIdent     String?          // 标识符，如 "GB/T"，由代码自动提取
  standardStatus    StandardStatus   @default(CURRENT)  // 细粒度状态：现行/即将实施/已废止
  publishDate       DateTime?        // 发布日期
  implementDate     DateTime?        // 实施日期
  abolishDate       DateTime?        // 废止日期
  content           String?          @db.Text  // 标准全文内容（从上传文件解析或手动输入），支持长文本
  folderId          String?          // 所属文件夹
  folder            StandardFolder?  @relation(fields: [folderId], references: [id])
  maxkbDocId        String?          // MaxKB 文档 ID
  source            String?          // 来源：manual/import/normative_import/maxkb/temp_archive
  importedBy        String?          // 导入人（用户ID）
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tasks             Task[]
  taskStandards     TaskStandard[]

  @@map("standards")
}

model Task {
  id                 String         @id @default(uuid())
  title              String
  description        String?
  status             TaskStatus     @default(PENDING)
  reviewMode         ReviewMode     @default(LIBRARY_REVIEW)  // 审查模式
  creatorId          String
  creator            User           @relation(fields: [creatorId], references: [id])
  standardId         String?
  standard           Standard?      @relation(fields: [standardId], references: [id])
  // maxkbKnowledgeId — 恢复用于 MaxKB 知识库集成
  maxkbKnowledgeId   String?        // 用户选择的知识库 ID（审查时使用特定知识库）
  perspective        String?        // 审查立场
  preAnalysisData    Json?          @map("pre_analysis_data")   // 预分析结果
  reviewPlan         Json?          @map("review_plan")         // 审查方案
  selfCheckReport    Json?          @map("self_check_report")   // 标准引用自检报告
  knowledgeCategoryId String?       // 关联的知识子库 ID
  ruleLibraryId       String?        @map("rule_library_id")  // 关联的规则库 ID
  ruleLibrary         RuleLibrary?   @relation(fields: [ruleLibraryId], references: [id], onDelete: SetNull)
  aiEngineUsed        String?        @map("ai_engine_used")   // 实际使用的 AI 引擎（如 llm-direct, llm-with-knowledge, rag-llm 等）
  files              TaskFile[]
  details            TaskDetail[]
  taskStandards      TaskStandard[]
  refFileGroups      RefFileGroup[]
  stats              Json?          @map("stats")  // 任务级统计：token 用量/成本/调用次数（可观测性 P2）
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("tasks")
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReviewMode {
  LIBRARY_REVIEW    // 以库审文 — 使用标准库+规则引擎+MaxKB/LLM
  DOC_REVIEW        // 以文审文 — 上游参照文件比对
  CONSISTENCY       // 全文一致性 — 跨文件参数/语义比对
  TYPO_GRAMMAR      // 错别字/语法 — 轻量LLM直接调用
  MULTIMODAL        // 多模态识别 — 表格/公式/图纸
  RULE_ONLY       // 仅规则审查 — 只跑规则引擎，不调 AI
  SELF_CHECK        // 标准引用自检 — 机械匹配，独立于AI审查
  CONTRACT_REVIEW   // 合同风险审查 — 合同专用审查模式
  RULE_PARSING      // 规则解析 — 从文档中异步解析候选规则
  CUSTOM_RULE       // 兼容历史数据
  FULL_REVIEW       // 兼容历史数据
}

model TaskFile {
  id              String        @id @default(uuid())
  taskId          String
  task            Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName        String
  filePath        String
  fileSize        Int           @default(0)
  fileType        String        // dwg, doc, docx, xls, xlsx, pdf
  status          FileStatus    @default(PENDING)
  textLength      Int           @default(0)    // 提取的文本总字符数
  processedLength Int           @default(0)    // 已审查的字符数
  errorCount      Int           @default(0)
  extractedText      String?       @db.Text  // 解析后的纯文本（规则引擎用，缓存）
  extractedMarkdown  String?       @db.Text  // 解析后的 Markdown（LLM 审查+前端预览用，缓存）
  dwgMetadata      Json?    @map("dwg_metadata")  // DWG 文件级元数据（图层列表、图元统计等）
  documentKey      String?     @unique @map("document_key")  // OnlyOffice 文档密钥，用于缓存失效
  details         TaskDetail[]
  versions        FileVersion[]
  createdAt       DateTime      @default(now())

  @@map("task_files")
}

model FileVersion {
  id           String   @id @default(uuid())
  fileId       String
  file         TaskFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  versionNo    Int      @map("version_no")
  sourceAction String   @map("source_action")    // replace-text, batch-replace-text, manual-save
  storagePath  String?  @map("storage_path")      // 快照文件路径
  plainText    String?  @map("plain_text") @db.Text  // 提取的纯文本（用于 diff）
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([fileId, versionNo])
  @@index([fileId])
  @@map("file_versions")
}

enum FileStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model TaskDetail {
  id            String    @id @default(uuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileId        String?
  file          TaskFile? @relation(fields: [fileId], references: [id])
  issueType     String    // TYPO, VIOLATION, NAMING, ENCODING, ATTRIBUTE, HEADER, PAGE, SCAN, TEMPLATE
  ruleCode      String?   // 规则错误代码: NAME_001, CODE_001, UNIT_001, ATTR_001, HEADER_001, PAGE_001, SCAN_001 等
  severity      String    @default("warning") // error, warning, info
  reviewSource  String?   @default("RULE_ENGINE") @map("review_source") // RULE_ENGINE, REVIEW_SPECIFICATION, STANDARD_REF, AI
  specificationItemId String? @map("specification_item_id")
  originalText  String
  suggestedText String?
  description   String?
  plainLanguage String?   @map("plain_language") @db.Text  // 大白话解释
  cadHandleId   String?   // CAD 图元 Handle ID，用于在 CAD 中定位
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  diffRanges      Json?     // 字符级差异区间: { original: [{start,length}], correct: [{start,length}] }
  matchLevel      Int?      // 标准引用匹配级别 (1-8)
  similarity      Float?    // Levenshtein 相似度 (0-1)
  standardRefId   String?   // 关联的标准库记录ID（用于跳转到标准详情）
  standardRef     String?   // 标准条文引用（如 "GB/T 50265-2010 第5.2.1条"）
  isFalsePositive  Boolean   @default(false)   // 是否为误报
  adopted          Boolean   @default(false)   // 是否已采纳
  adoptedBy        String?                      // 采纳人用户ID
  adoptedAt        DateTime?                    // 采纳时间
  fpMarkedBy       String?                     // 标记误报的用户ID
  fpMarkedAt       DateTime?                    // 标记误报的时间
  fpReason         String?                      // 误报原因
  sourceReferences Json?                        // MaxKB RAG 溯源：[{content, document_name, similarity}]
  textPosition     Json?                        // 文本位置信息：{chunkIndex, charOffset, totalChunks} 用于前端定位
  dwgMetadata      Json?    @map("dwg_metadata") // DWG 解析元数据（图层、图元、标注等）

  locateMeta       Json?    @map("locate_meta") // 新版定位元数据：absolute range + quote + context

  // 合同审查专属字段
  riskLevel        String?  // 风险等级: HIGH / MEDIUM / LOW
  clauseType       String?  // 条款类型: payment / penalty / warranty / ip / change / claim / insurance / dispute / other
  recommendation   String?  @db.Text  // 修改建议

  @@unique([taskId, fileId, issueType, ruleCode, originalText])
  @@map("task_details")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  resource  String
  details   Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

model ReviewRule {
  id          String   @id @default(uuid())
  ruleCode    String   @unique  // NAME_001, CODE_001, UNIT_001, ATTR_001, HEADER_001, PAGE_001, SCAN_001
  name        String             // 规则名称
  category    String             // NAMING, ENCODING, ATTRIBUTE, HEADER, PAGE, SCAN, TEMPLATE
  description String             // 规则描述
  severity    String   @default("warning") // error, warning, info
  enabled     Boolean  @default(true)      // 是否启用
  config      Json?              // 规则配置参数（正则、阈值等，支持高级定制）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("review_rules")
}

model TaskStandard {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  standardId  String
  standard    Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([taskId, standardId])
  @@map("task_standards")
}

// ===== 以文审文：参照文件组 =====

model RefFileGroup {
  id          String     @id @default(uuid())
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  groupName   String     @default("默认参照组")  // 参照文件组名称
  description String?    // 组描述
  refFiles    RefFile[]
  createdAt   DateTime   @default(now())

  @@map("ref_file_groups")
}

model RefFile {
  id           String       @id @default(uuid())
  groupId      String
  group        RefFileGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fileName     String       // 原始文件名
  filePath     String       // 存储路径
  fileSize     Int          @default(0)
  fileType     String       // dwg, doc, docx, xls, xlsx, pdf
  extractedText String?     @db.Text  // 解析后的文本（缓存，避免重复解析）
  createdAt    DateTime     @default(now())

  @@map("ref_files")
}

// ===== 专业术语白名单 =====

model TerminologyWhitelist {
  id          String   @id @default(uuid())
  term        String             // 术语名称
  category    String             // 分类：核安全术语、设备术语、工艺术语、建筑术语、电气术语、自定义
  aliases     String?            // 别名列表，逗号分隔
  isBuiltin   Boolean  @default(false)  // 是否为内置术语（不可删除）
  createdBy   String?            // 创建者
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([term, category])
  @@map("terminology_whitelist")
}

// ===== 提示词模板管理 =====

model PromptTemplate {
  id          String   @id @default(uuid())
  key         String   @unique   // 唯一标识: library_review_system, typo_grammar_system, ...
  module      String             // 审查场景: library_review, consistency, typo_grammar, doc_review, multimodal, ocr
  role        String             // 角色: system, user
  variant     String   @default("default")  // 用户提示词变体: default, with_context, no_context, comparison, structural, instruction
  name        String             // 显示名称: "合规审查-系统提示词"
  description String?            @db.Text  // 用途说明
  content     String             @db.Text  // 提示词模板内容（支持 ${text}, ${ragContext}, ${standardContext}, ${refTexts} 等占位符）
  placeholders String?           // 可用占位符说明，JSON 数组: ["${text}", "${ragContext}"]
  defaultValue String?           @db.Text  // 默认值（用于重置）
  isBuiltin   Boolean  @default(true)   // 是否为内置模板（内置模板不可删除）
  enabled     Boolean  @default(true)   // 是否启用
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prompt_templates")
}

// ===== 误报标记库 =====

model FalsePositiveLibrary {
  id            String   @id @default(uuid())
  originalText  String             @db.Text  // 被标记为误报的原文
  fpReason      String?            @db.Text  // 误报原因
  issueType     String?            // 问题分类
  ruleCode      String?            // 规则代码
  severity      String?            // 严重度
  markedById    String?            // 标记人用户ID
  markedByName  String?            // 标记人姓名（冗余存储便于显示）
  taskId        String?            // 关联的任务ID
  taskTitle     String?            // 关联的任务标题（冗余存储）
  count         Int      @default(1)  // 被标记次数（同一文本可能被多次标记）
  lastMarkedAt  DateTime @default(now())  // 最后标记时间
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([originalText])
  @@index([issueType])
  @@index([lastMarkedAt])
  @@map("false_positive_library")
}

// ===== 临时标准库（持久化） =====

model TempStandardEntry {
  id             String   @id @default(uuid())
  userId         String             // 所属用户ID（按用户隔离）
  standardNo     String             // 标准编号
  standardName   String?            // 标准名称
  standardIdent  String?            // 标识符，如 "GB/T"
  rawText        String?            @db.Text  // 原始文本（Excel 行内容）
  sourceFile     String?            // 来源文件名
  importType     String   @default("excel")  // 导入方式：excel | manual
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("temp_standard_entries")
}

// ===== 反馈建议模块 =====

enum FeedbackStatus {
  PENDING       // 待处理
  IN_PROGRESS   // 处理中
  RESOLVED      // 已解决
  CLOSED        // 已关闭
}

enum FeedbackCategory {
  BUG_REPORT        // Bug报告
  SUGGESTION        // 建议
  FEATURE_REQUEST   // 功能请求
  OTHER             // 其他
}

enum AnnouncementUrgency {
  NORMAL      // 普通
  IMPORTANT   // 重要
  URGENT      // 紧急
}

enum AnnouncementStatus {
  DRAFT       // 草稿
  PUBLISHED   // 已发布
  WITHDRAWN   // 已撤回
}

model Feedback {
  id              String          @id @default(uuid())
  title           String                          // 反馈标题
  content         String          @db.Text        // 反馈内容
  category        FeedbackCategory @default(OTHER) // 反馈类别
  status          FeedbackStatus  @default(PENDING) // 处理状态
  userId          String                          // 提交用户ID
  user            User            @relation(fields: [userId], references: [id])
  attachmentPaths Json?                           // 附件路径数组: [{id, fileName, filePath, fileSize, fileType}]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  resolvedAt      DateTime?                       // 解决时间
  resolverId      String?                         // 处理人ID
  resolvedBy      User?           @relation("FeedbackResolver", fields: [resolverId], references: [id])
  remark          String?         @db.Text        // 处理备注

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("feedbacks")
}

// ===== 系统公告模块 =====

model SystemAnnouncement {
  id            String                @id @default(uuid())
  title         String                                    // 标题（max 200）
  content       String                @db.Text            // Markdown 内容（max 50000）
  urgency       AnnouncementUrgency   @default(NORMAL)    // 紧急程度
  status        AnnouncementStatus    @default(DRAFT)     // 发布状态
  publishAt     DateTime?                                 // 发布时间
  withdrawnAt   DateTime?                                 // 撤回时间
  createdBy     String                                    // 创建人（管理员）
  creator       User                  @relation(fields: [createdBy], references: [id])
  reads         UserAnnouncementRead[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, publishAt])
  @@map("system_announcements")
}

model UserAnnouncementRead {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  announcementId  String
  announcement    SystemAnnouncement @relation(fields: [announcementId], references: [id])
  readAt          DateTime           @default(now())
  confirmed       Boolean            @default(false)  // 紧急通知是否已确认

  @@unique([userId, announcementId])
  @@index([userId])
  @@map("user_announcement_reads")
}

// ===== 知识子库管理 =====

model KnowledgeCategory {
  id              String            @id @default(uuid())
  name            String                              // 子库名称
  description     String?           @db.Text           // 描述
  status          KnowledgeCategoryStatus @default(ACTIVE)
  parentId        String?
  parent          KnowledgeCategory? @relation("KnowledgeCategoryToKnowledgeCategory", fields: [parentId], references: [id])
  children        KnowledgeCategory[] @relation("KnowledgeCategoryToKnowledgeCategory")
  isLeaf          Boolean                      @default(true)    @map("is_leaf")         // 是否为叶子节点（知识库容器）
  vectorDocuments VectorDocument[]
  documents       Document[]
  tags            Tag[]
  chunkMode       String            @default("auto") @map("chunk_mode")  // auto, fixed, paragraph, table-aware
  maxChars        Int               @default(900) @map("max_chars")       // 分块最大字符数
  overlap         Int               @default(120) @map("overlap")         // 分块重叠字符数
  minSimilarity   Float             @default(0.6) @map("min_similarity")
  directReturnThreshold Float       @default(0.9) @map("direct_return_threshold")
  maxReferenceChars Int             @default(5000) @map("max_reference_chars")
  enableRerank    Boolean           @default(true) @map("enable_rerank")
  embeddingUseDocumentTitle Boolean @default(true) @map("embedding_use_document_title")
  embeddingUseClauseId Boolean      @default(false) @map("embedding_use_clause_id")
  contextualRetrieval Boolean      @default(false) @map("contextual_retrieval")
  permissions     KnowledgeCategoryPermission[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("knowledge_categories")
}

enum KnowledgeCategoryStatus {
  ACTIVE
  ARCHIVED
}

// 目录级权限表
model KnowledgeCategoryPermission {
  id            String          @id @default(uuid())
  categoryId    String          @map("category_id")
  category      KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  principalType PermissionPrincipalType @default(ROLE) @map("principal_type") // 主体类型：user/role/dept
  principalId   String          @map("principal_id")                           // 主体 ID
  permission    CategoryPermission     @default(READ)                          // 权限
  inherited     Boolean         @default(false)                               // 是否从父级继承
  createdAt     DateTime        @default(now())

  @@unique([categoryId, principalType, principalId, permission])
  @@index([categoryId])
  @@map("knowledge_category_permissions")
}

enum PermissionPrincipalType {
  USER
  ROLE
  DEPARTMENT
}

enum CategoryPermission {
  READ
  WRITE
  UPLOAD
  PUBLISH
  ADMIN
}

// ===== 文档实体（与向量分离，支持版本管理） =====

model Document {
  id                    String              @id @default(uuid())
  categoryId            String?
  category              KnowledgeCategory?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  title                 String                                  // 文档标题（同一分类下唯一）
  sourceFile            String?             @map("source_file")  // 原始文件名
  sourceType            String              @default("standard")  @map("source_type") // standard, law, reference, rule
  status                DocumentStatus      @default(ACTIVE)
  
  totalChunks           Int                 @default(0)  @map("total_chunks")
  totalChars            Int                 @default(0)  @map("total_chars")
  
  isVectorized          Boolean             @default(false) @map("is_vectorized")
  vectorStatus          String?             @map("vector_status") // PENDING/PARSING/EMBEDDING/SUCCESS/FAILURE
  progress              Int                 @default(0) @map("progress") // 0-100 处理进度
  errorMessage          String?             @map("error_message") // 失败原因

  parseScore            Int?                @map("parse_score")
  parseReport           Json?               @map("parse_report")
  
  metadata              Json?
  
  currentVersion        Int                 @default(1) @map("current_version")
  createdBy             String?             @map("created_by")
  
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  
  chunks                VectorDocument[]
  versions              DocumentVersion[]
  tags                  DocumentTag[]
  
  @@unique([categoryId, title])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("documents")
}

enum DocumentStatus {
  ACTIVE    // 正常/已发布
  DRAFT     // 草稿（解析中）
  ARCHIVED  // 已归档
  DELETED   // 已删除（软删除）
}

// ===== 文档版本历史 =====

model DocumentVersion {
  id              String    @id @default(uuid())
  documentId      String
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version         Int
  
  content         String    @db.Text  // Markdown 内容
  chunkCount      Int       @map("chunk_count")
  totalChars      Int       @map("total_chars")
  
  sourceFile      String?   @map("source_file")
  parseScore      Int?      @map("parse_score")
  parseReport     Json?     @map("parse_report")
  
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  
  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

// ===== 向量文档（段落级，与 Document 关联） =====

model VectorDocument {
  id              String              @id @default(uuid())
  documentId      String?             @map("document_id")      // 关联文档
  document        Document?           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        KnowledgeCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  sourceType      String              @map("source_type")     // standard, law, reference, rule
  sourceId        String?             @map("source_id")       // 来源标识
  title           String?                                    // 所属文档标题（冗余存储，便于检索）
  clauseId        String?             @map("clause_id")       // 条文编号
  content         String              @db.Text                // 文本内容
  contentHash     String?             @map("content_hash")    // SHA-256 去重
  chunkIndex      Int                 @default(0) @map("chunk_index")
  metadata        Json?                                       // 附加元数据
  
  embedding       Unsupported("vector")?                     // pgvector 向量（支持任意维度）
  vectorStatus    String              @default("PENDING") @map("vector_status") // PENDING/STARTED/SUCCESS/FAILURE
  searchVector    Unsupported("tsvector")?                  @map("search_vector") // 全文检索向量
  
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([documentId])
  @@index([categoryId])
  @@index([sourceType, sourceId])
  @@index([contentHash])
  @@index([title])
  @@map("vector_documents")
}

// ===== 文档标签体系 =====

model Tag {
  id          String        @id @default(uuid())
  key         String                              // 标签名（如"文档类型"、"适用阶段"）
  value       String                              // 标签值（如"设计文件"、"施工阶段"）
  categoryId  String?       @map("category_id")   // 所属知识子库
  category    KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  documents   DocumentTag[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([key, value, categoryId])
  @@index([categoryId])
  @@map("tags")
}

model DocumentTag {
  id             String      @id @default(uuid())
  tagId          String      @map("tag_id")
  tag            Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  documentId     String      @map("document_id")  // 关联 Document
  document       Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  categoryId     String?     @map("category_id")     // 从 Document 冗余，方便查询
  documentTitle  String?     @map("document_title")  // 从 Document 冗余，方便查询
  createdAt      DateTime    @default(now()) @map("created_at")

  @@unique([tagId, documentId])
  @@index([documentId])
  @@index([categoryId])
  @@map("document_tags")
}

// ===== 审查规范集 =====

model SpecificationFolder {
  id        String                  @id @default(uuid())
  name      String
  parentId  String?
  parent    SpecificationFolder?    @relation("SpecificationFolderTree", fields: [parentId], references: [id])
  children  SpecificationFolder[]   @relation("SpecificationFolderTree")
  sortOrder Int                    @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@map("specification_folders")
}

// ===== 规则库 =====

enum RuleLibraryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model RuleLibrary {
  id              String              @id @default(uuid())
  name            String
  description     String?             @db.Text
  sourceFileName  String?             @map("source_file_name")
  status          RuleLibraryStatus   @default(DRAFT)
  createdBy       String
  items           RuleLibraryItem[]
  tasks           Task[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("rule_libraries")
}

model RuleLibraryItem {
  id              String        @id @default(uuid())
  libraryId       String
  library         RuleLibrary   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  ruleCode        String?       @map("rule_code")
  ruleName        String?       @map("rule_name")
  category        String?
  description     String?       @db.Text
  checkMethod     String?       @map("check_method") @db.Text
  severity        String?       @default("warning")
  executionType   String?       @default("BUILTIN_PREFIX") @map("execution_type")
  builtinPrefix   String?       @map("builtin_prefix")
  targetScope     String?       @default("TEXT") @map("target_scope")
  params          Json?
  messageTemplate String?       @map("message_template") @db.Text
  sourceQuote     String?       @map("source_quote") @db.Text
  sourceLocation  String?       @map("source_location")
  enabled         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([libraryId])
  @@map("rule_library_items")
}

// ===== 智能问答 =====

model QASession {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  title           String?       // 会话标题（首条问题截取）
  taskId          String?       // 可选关联的审查任务
  messages        QAMessage[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@map("qa_sessions")
}

model QAMessage {
  id              String        @id @default(uuid())
  sessionId       String        @map("sessionId")
  session         QASession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role            String        // user, assistant, system
  content         String        @db.Text
  status          String        @default("processing") // processing, completed, failed
  sources         Json?         // 引用来源
  debug           Json?         // 调试信息
  createdAt       DateTime      @default(now()) @map("createdAt")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([sessionId])
  @@map("qa_messages")
}

// MaxKB embedded chat user session — pairs (userId, applicationId) with a sticky MaxKB chatUserToken,
// so iframe embed mode (chat/<accessToken>?mode=embed&token=<chatUserToken>) can isolate per-user history.
model UserChatSession {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  accessToken   String
  chatUserToken String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, applicationId])
  @@index([userId])
  @@map("user_chat_sessions")
}

// LLM 调用日志 - 每次审查的模型调用记录（可观测性 P2）
model LlmCallLog {
  id               BigInt   @id @default(autoincrement()) @db.BigInt
  taskId           String?  @map("task_id") @db.VarChar(50)
  mode             String?  @db.VarChar(50)       // 审查模式
  model            String   @db.VarChar(100)      // 模型名称
  provider         String?  @db.VarChar(50)       // 供应商
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  latencyMs        Int      @default(0) @map("latency_ms")    // 耗时（毫秒）
  status           String   @default("success") @db.VarChar(20)  // success/failed/cache
  errorMsg         String?  @map("error_msg") @db.Text
  costEstimate     Float?   @map("cost_estimate")  // 预估成本（元）
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([taskId], name: "idx_llm_log_task_id")
  @@index([model], name: "idx_llm_log_model")
  @@index([createdAt], name: "idx_llm_log_created_at")
  @@map("llm_call_log")
}
