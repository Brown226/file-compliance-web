# ============================================
# 文件智能审查系统 - 后端服务 Dockerfile
# 生产镜像瘦身版：仅保留运行所需依赖
# ============================================

# ============================================
# 阶段1: 构建阶段（安装全量依赖，生成 Prisma Client）
# ============================================
FROM node:20-alpine AS prisma-builder

WORKDIR /app

RUN apk add --no-cache openssl ca-certificates wget

# 复制 package 文件并安装全量依赖（用于 build + prisma generate）
COPY backend/package*.json ./
RUN npm ci

# 复制 Prisma Schema 并生成 Client
COPY backend/prisma/ ./prisma/
RUN npx -p prisma@5.22.0 prisma generate

# ============================================
# 阶段2: 运行阶段（仅生产依赖）
# ============================================
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache openssl ca-certificates

# 仅安装生产依赖，避免 devDependencies 膨胀镜像
COPY backend/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# 复制 Prisma 运行时引擎（由 builder 阶段生成）
COPY --from=prisma-builder /app/node_modules/.prisma ./node_modules/.prisma

# 复制编译产物
COPY backend/dist ./dist

# 复制 Prisma Schema 和迁移文件（运行时 migrate/db push 需要）
COPY backend/prisma ./prisma

# 复制入口脚本
COPY backend/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# 复制环境变量文件
COPY .env.production .env

# 创建上传目录
RUN mkdir -p /app/uploads

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
